[Unit]
Description=Talking Skelly Raspberry Pi voice client
After=network-online.target bluetooth.target sound.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/talking-skelly
ExecStart=/usr/bin/node %h/talking-skelly/pi/skelly-pi.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
